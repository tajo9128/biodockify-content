[{"id":117,"date":"2026-02-16T09:58:59","date_gmt":"2026-02-16T09:58:59","guid":{"rendered":"https:\/\/learn.biodockify.com\/home\/"},"modified":"2026-02-16T10:10:59","modified_gmt":"2026-02-16T10:10:59","slug":"home","status":"publish","type":"page","link":"https:\/\/learn.biodockify.com\/","title":{"rendered":"Home"},"content":{"rendered":"<div style=\"background: #0a0f1c; min-height: 100vh; padding: 80px 40px; font-family: -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif;\">\n<div style=\"max-width: 900px; margin: 0 auto;\">\n<div style=\"text-align: center;\"><span style=\"background: rgba(0, 240, 255, 0.08); color: #00f0ff; padding: 10px 20px; border-radius: 30px; font-size: 14px; border: 1px solid rgba(0, 240, 255, 0.2);\">\u25c6 Molecular Docking as a Service<\/span><\/p>\n<h1 style=\"font-family: Space Grotesk, sans-serif; font-size: 64px; font-weight: 700; margin: 32px 0 20px; line-height: 1.1; color: #f0f6fc;\">The future of drug discovery is <span style=\"background: linear-gradient(135deg, #00f0ff, #ff00aa, #a855f7); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;\">computational<\/span><\/h1>\n<p style=\"color: #8b949e; font-size: 20px; line-height: 1.7; max-width: 600px; margin: 0 auto 48px;\">AI-powered molecular docking platform. Dock molecules, predict binding affinities, and accelerate research.<\/p>\n<div style=\"display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; margin-bottom: 80px;\"><a href=\"\/blog\" style=\"background: linear-gradient(135deg, #00f0ff, #ff00aa); color: white; padding: 16px 32px; border-radius: 10px; text-decoration: none; font-weight: 600; font-size: 16px; box-shadow: 0 0 40px rgba(0, 240, 255, 0.3); transition: all 0.3s ease;\">Start Docking \u2192<\/a><a href=\"\/courses\" style=\"background: transparent; color: #c9d1d9; padding: 16px 32px; border-radius: 10px; text-decoration: none; font-weight: 500; border: 1px solid #30363d;\">Learn More<\/a><\/div>\n<\/div>\n<div style=\"display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; margin-bottom: 80px;\">\n<div style=\"background: #0f1623; border: 1px solid #1e293b; border-radius: 16px; padding: 32px 24px; text-align: center;\">\n<div style=\"font-family: Space Grotesk, sans-serif; font-size: 42px; font-weight: 700; background: linear-gradient(135deg, #00f0ff, #ff00aa); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;\">10K+<\/div>\n<div style=\"color: #8b949e; font-size: 14px; margin-top: 8px;\">Molecules Docked<\/div>\n<\/div>\n<div style=\"background: #0f1623; border: 1px solid #1e293b; border-radius: 16px; padding: 32px 24px; text-align: center;\">\n<div style=\"font-family: Space Grotesk, sans-serif; font-size: 42px; font-weight: 700; background: linear-gradient(135deg, #00f0ff, #ff00aa); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;\">500+<\/div>\n<div style=\"color: #8b949e; font-size: 14px; margin-top: 8px;\">Research Projects<\/div>\n<\/div>\n<div style=\"background: #0f1623; border: 1px solid #1e293b; border-radius: 16px; padding: 32px 24px; text-align: center;\">\n<div style=\"font-family: Space Grotesk, sans-serif; font-size: 42px; font-weight: 700; background: linear-gradient(135deg, #00f0ff, #ff00aa); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;\">50+<\/div>\n<div style=\"color: #8b949e; font-size: 14px; margin-top: 8px;\">Institutions<\/div>\n<\/div>\n<div style=\"background: #0f1623; border: 1px solid #1e293b; border-radius: 16px; padding: 32px 24px; text-align: center;\">\n<div style=\"font-family: Space Grotesk, sans-serif; font-size: 42px; font-weight: 700; background: linear-gradient(135deg, #00f0ff, #ff00aa); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;\">99.9%<\/div>\n<div style=\"color: #8b949e; font-size: 14px; margin-top: 8px;\">Uptime SLA<\/div>\n<\/div>\n<\/div>\n<h2 style=\"font-family: Space Grotesk, sans-serif; font-size: 42px; font-weight: 700; text-align: center; margin-bottom: 48px; color: #f0f6fc;\">Built for modern research<\/h2>\n<div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px; margin-bottom: 80px;\">\n<article style=\"background: #0f1623; border: 1px solid #1e293b; border-radius: 16px; padding: 32px;\">\n<div style=\"font-size: 36px; margin-bottom: 16px;\">\ud83e\uddec<\/div>\n<h3 style=\"color: #f0f6fc; font-size: 20px; font-weight: 600; margin: 0 0 12px;\">AutoDock Vina Integration<\/h3>\n<p style=\"color: #8b949e; font-size: 15px; line-height: 1.7; margin: 0;\">State-of-the-art molecular docking powered by the industry-standard algorithm.<\/p>\n<\/article>\n<article style=\"background: #0f1623; border: 1px solid #1e293b; border-radius: 16px; padding: 32px;\">\n<div style=\"font-size: 36px; margin-bottom: 16px;\">\ud83e\udd16<\/div>\n<h3 style=\"color: #f0f6fc; font-size: 20px; font-weight: 600; margin: 0 0 12px;\">AI-Enhanced Predictions<\/h3>\n<p style=\"color: #8b949e; font-size: 15px; line-height: 1.7; margin: 0;\">Machine learning models improve binding affinity predictions.<\/p>\n<\/article>\n<article style=\"background: #0f1623; border: 1px solid #1e293b; border-radius: 16px; padding: 32px;\">\n<div style=\"font-size: 36px; margin-bottom: 16px;\">\u2601\ufe0f<\/div>\n<h3 style=\"color: #f0f6fc; font-size: 20px; font-weight: 600; margin: 0 0 12px;\">Cloud-Native Architecture<\/h3>\n<p style=\"color: #8b949e; font-size: 15px; line-height: 1.7; margin: 0;\">Scale from one to thousands of dockings. Pay only for compute time.<\/p>\n<\/article>\n<article style=\"background: #0f1623; border: 1px solid #1e293b; border-radius: 16px; padding: 32px;\">\n<div style=\"font-size: 36px; margin-bottom: 16px;\">\ud83d\udcca<\/div>\n<h3 style=\"color: #f0f6fc; font-size: 20px; font-weight: 600; margin: 0 0 12px;\">Interactive Visualizations<\/h3>\n<p style=\"color: #8b949e; font-size: 15px; line-height: 1.7; margin: 0;\">3D molecule viewers and binding affinity charts.<\/p>\n<\/article>\n<article style=\"background: #0f1623; border: 1px solid #1e293b; border-radius: 16px; padding: 32px;\">\n<div style=\"font-size: 36px; margin-bottom: 16px;\">\ud83d\udd17<\/div>\n<h3 style=\"color: #f0f6fc; font-size: 20px; font-weight: 600; margin: 0 0 12px;\">API-First Design<\/h3>\n<p style=\"color: #8b949e; font-size: 15px; line-height: 1.7; margin: 0;\">REST API, Python SDK, and CLI tools available.<\/p>\n<\/article>\n<article style=\"background: #0f1623; border: 1px solid #1e293b; border-radius: 16px; padding: 32px;\">\n<div style=\"font-size: 36px; margin-bottom: 16px;\">\ud83d\udd12<\/div>\n<h3 style=\"color: #f0f6fc; font-size: 20px; font-weight: 600; margin: 0 0 12px;\">Enterprise Security<\/h3>\n<p style=\"color: #8b949e; font-size: 15px; line-height: 1.7; margin: 0;\">SOC 2 compliant with role-based access control.<\/p>\n<\/article>\n<\/div>\n<div style=\"background: linear-gradient(135deg, rgba(0, 240, 255, 0.05), rgba(255, 0, 170, 0.05)); border: 1px solid rgba(0, 240, 255, 0.2); border-radius: 24px; padding: 60px; text-align: center;\">\n<h2 style=\"font-family: Space Grotesk, sans-serif; font-size: 32px; font-weight: 700; margin: 0 0 16px; color: #f0f6fc;\">Ready to accelerate your research?<\/h2>\n<p style=\"color: #8b949e; font-size: 18px; margin: 0 0 32px;\">Join 500+ research teams using BioDockify<\/p>\n<p><a href=\"\/courses\" style=\"background: linear-gradient(135deg, #00f0ff, #ff00aa); color: white; padding: 16px 32px; border-radius: 10px; text-decoration: none; font-weight: 600; font-size: 16px; display: inline-block;\">Get Started Free \u2192<\/a><\/div>\n<\/div>\n<\/div>\n","protected":false},"excerpt":{"rendered":"<p>\u25c6 Molecular Docking as a Service The future of drug discovery is computational AI-powered molecular docking platform. Dock molecules, predict [&hellip;]<\/p>\n","protected":false},"author"